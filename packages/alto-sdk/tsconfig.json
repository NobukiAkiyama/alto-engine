{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "stripInternal": true
  },
  "include": [
    "src/index.ts",
    "src/browser.ts",
    "src/unstable.ts",
    "src/testing.ts"
  ]
}
